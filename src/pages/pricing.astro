---
/**
 * Pricing, while Toft is in beta: it is free, and the page says only that.
 */
import Site from "../layouts/Site.astro";
import Icon from "../components/Icon.astro";
import { PLAYGROUND } from "../links";

const title = "Pricing — Toft";
const description = "Toft is free while it’s in beta.";
---

<Site title={title} description={description}>
  <section class="container hero">
    <div class="hero-grid rise">
      <div>
        <p class="eyebrow">Pricing</p>
        <h1>Free while Toft is in beta.</h1>
      </div>
      <div class="hero-side">
        <p class="lede">
          Install it on your own servers and use it at no cost while it’s in beta. Nothing to sign up for.
        </p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container close">
      <div>
        <h2 class="display">Try it first.</h2>
        <p class="lede">The playground is a real Toft, free to use.</p>
      </div>
      <div class="actions">
        <a class="button primary lg" href={PLAYGROUND}>Try the playground <Icon name="arrow-right" /></a>
        <a class="button outline lg" href="/#get-started">Install Toft</a>
      </div>
    </div>
  </section>
</Site>
